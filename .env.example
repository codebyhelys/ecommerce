# E-mail: em desenvolvimento os e-mails aparecem no console. Em produção use SMTP:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.exemplo.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=Loja <nao-responda@exemplo.com>
# Uploads (imagens de produto)
# MEDIA_ROOT=./media
# PRODUCT_IMAGE_MAX_BYTES=5242880
# Fila (Celery): vazio = tarefas na hora, sem worker. Use o Redis em OUTRO banco lógico que o cache (/1):
# CELERY_BROKER_URL=redis://:troque-por-uma-senha-longa@127.0.0.1:16379/1
# Armazenamento de imagens (SeaweedFS em Docker; em produção, S3/R2 com chave só desse bucket)
